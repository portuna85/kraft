# .env로 복사해 실제 값을 입력한다. .env는 Git에서 제외된다.
# local 프로파일은 프로젝트 루트의 .env를 Java properties로 읽으므로 따옴표나 export 없이
# KEY=value를 쓴다. 같은 이름의 OS 환경변수가 .env보다 우선한다.

# docker-compose의 mariadb 서비스 초기화에 쓰는 값.
# 기존 볼륨에서는 아래 값을 바꾸어도 DB 계정·비밀번호가 자동 변경되지 않는다.
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_DATABASE=kraft
MARIADB_USER=kraft
MARIADB_PASSWORD=change-me-db-password

# 앱(local 프로파일)이 읽는 DataSource 접속 정보.
# MARIADB_USER·MARIADB_PASSWORD와 같은 값을 넣는다.
DB_URL=jdbc:mariadb://localhost:3306/kraft
DB_USERNAME=kraft
DB_PASSWORD=change-me-db-password

# DB의 호스트 공개 포트. 바꾸면 위 DB_URL의 포트도 함께 바꾼다.
DB_PORT=3306

# 이메일 암호화 키. 기존 데이터가 있으면 키를 유지한다.
# local은 미지정 시 개발용 기본 키를 쓰며 prod에는 필수다(application-prod.yml).
EMAIL_ENCRYPTION_KEY=change-me-32-byte-random-key

# 이메일 인증 링크에 붙일 브라우저 접속 주소.
APP_BASE_URL=http://localhost:8080

# 실제 이메일 인증을 사용할 때 설정한다.
# Gmail은 일반 비밀번호가 아니라 앱 비밀번호를 MAIL_PASSWORD에 넣는다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me-app-password

# 실행: docker compose up -d --wait 로 DB를 띄운 뒤 .\gradlew.bat bootRun
