# 이 파일을 복사해 .env로 저장하고 실제 값을 채운다: cp .env.example .env
# .env는 git에 커밋되지 않는다(.gitignore).

# --- docker-compose의 mariadb 서비스 초기화용 ---
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_DATABASE=kraft
MARIADB_USER=kraft
MARIADB_PASSWORD=change-me-db-password

# --- Spring Boot(local 프로파일, 기본값)이 읽는 DataSource 접속 정보 ---
# 2026-09-11부터 local 프로파일이 H2 대신 이 값으로 docker-compose의 실제 MariaDB에
# 접속한다(gradlew test는 영향받지 않음 — src/test/resources/application-local.yml이
# H2로 강제 오버라이드한다). MARIADB_USER/MARIADB_PASSWORD와 동일한 값을 넣는다.
DB_URL=jdbc:mariadb://localhost:3306/kraft
DB_USERNAME=kraft
DB_PASSWORD=change-me-db-password

# --- User.email 컬럼 AES 암호화 키 (application.yml/application-prod.yml 참고) ---
EMAIL_ENCRYPTION_KEY=change-me-32-byte-random-key

# --- 이메일 인증 링크에 붙일 기본 URL ---
APP_BASE_URL=http://localhost:8080

# --- 실제 SMTP 발송(SmtpEmailSender, application.yml — local·prod 공통) ---
# Gmail 기준: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=본인 Gmail 주소,
# MAIL_PASSWORD=구글 계정의 앱 비밀번호(일반 로그인 비밀번호가 아님 — 2단계 인증 활성화 후
# 계정 설정 > 보안 > 앱 비밀번호에서 발급). 다른 SMTP 제공업체를 쓰면 그 제공업체의 값으로 바꾼다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me-app-password

# --- 실행 방법 ---
# 1) docker compose up -d 로 MariaDB를 먼저 띄운다.
# 2) 이 파일(.env)의 값을 OS 환경변수로 로드한다.
#    - bash: set -a; source .env; set +a
#    - PowerShell: Get-Content .env | Where-Object { $_ -match '^\s*[^#].*=' } | ForEach-Object {
#        $name, $value = $_ -split '=', 2; Set-Item -Path "env:$($name.Trim())" -Value $value.Trim() }
# 3) ./gradlew bootRun (프로파일 지정 불필요 — local이 기본값)
