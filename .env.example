# .env로 복사해 실제 값을 입력한다. .env는 Git과 Docker 빌드 컨텍스트에서 제외된다.
# local 프로파일도 Java properties로 읽으므로 따옴표나 export 없이 KEY=value를 쓴다.
# 같은 이름의 OS 환경변수가 .env보다 우선한다.

# MariaDB 초기화 및 Docker 앱 접속에 공통으로 사용하는 값.
# 기존 볼륨에서는 아래 값을 바꾸어도 DB 계정·비밀번호가 자동 변경되지 않는다.
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_DATABASE=kraft
MARIADB_USER=kraft
MARIADB_PASSWORD=change-me-db-password

# 호스트에서 IDE/bootRun으로 실행할 때만 쓰는 접속 정보.
# Docker 앱은 위 MARIADB_* 값과 서비스 이름 mariadb로 DB에 접속한다.
DB_URL=jdbc:mariadb://localhost:3306/kraft
DB_USERNAME=kraft
DB_PASSWORD=change-me-db-password

# 호스트 공개 포트. DB_PORT를 바꾸면 위 DB_URL의 포트도 함께 바꾼다.
DB_PORT=3306
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1

# 이메일 암호화 키. 기존 데이터가 있으면 키를 유지한다.
# local/docker는 미지정 시 같은 개발용 기본 키를 쓰며 prod에는 필수다.
EMAIL_ENCRYPTION_KEY=change-me-32-byte-random-key

# 브라우저에서 접속하는 주소. APP_PORT나 공개 주소를 바꾸면 함께 수정한다.
APP_BASE_URL=http://localhost:8080

# 실제 이메일 인증을 사용할 때 설정한다. 컨테이너의 localhost는 컨테이너 자신이다.
# 호스트의 SMTP 서버를 사용할 때는 Docker Desktop의 host.docker.internal을 지정한다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me-app-password

# 전체 실행: docker compose up -d --build --wait
# IDE 개발: docker compose up -d --wait mariadb 후 .\gradlew.bat bootRun
