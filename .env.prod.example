# Production environment template — rendered by scripts/deploy/render-env.sh via envsubst.
# All ${VAR} tokens are substituted from GitHub Actions secrets at deploy time.
# NOT read by Spring Boot directly. Spring Boot containers receive these
# values as OS environment variables via 'environment:' blocks in docker-compose.prod.yml.

# ── MariaDB container ─────────────────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=${MARIADB_ROOT_PASSWORD}
MARIADB_DATABASE=kraft_lotto
MARIADB_USER=kraft_lotto
MARIADB_PASSWORD=${MARIADB_PASSWORD}

# ── Backend (Spring Boot) ─────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
KRAFT_DB_URL=jdbc:mariadb://mariadb:3306/kraft_lotto?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
KRAFT_DB_USERNAME=kraft_lotto
KRAFT_DB_PASSWORD=${KRAFT_DB_PASSWORD}
KRAFT_LOG_PATH=/app/logs
# 교체 절차: GitHub Secrets의 KRAFT_OPS_TOKEN을 새 무작위 값으로 교체 후 재배포 → 즉시 적용(저장 없음, 단일 값 비교).
# 유출 의심 시 즉시 교체. 정기 교체는 분기 1회 권장.
KRAFT_OPS_TOKEN=${KRAFT_OPS_TOKEN}
# 교체 절차·주기는 README "시크릿 로테이션 런북" 참조 — 마찬가지로 저장 없는 단일 값 비교라 즉시 적용됨.
KRAFT_REVALIDATE_SECRET=${KRAFT_REVALIDATE_SECRET}
KRAFT_SAVED_MAX_PER_CLIENT=100
KRAFT_EXTERNAL_LOTTO_URL_TEMPLATE=${KRAFT_EXTERNAL_LOTTO_URL_TEMPLATE}
KRAFT_EXTERNAL_LOTTO_AUTO_COLLECT_CRON=0 30/15 21-23 * * SAT
KRAFT_EXTERNAL_LOTTO_REFERER=https://www.dhlottery.co.kr/lt645/result
KRAFT_EXTERNAL_LOTTO_REQUESTED_WITH=XMLHttpRequest
# BE-SEC-02(docs/improvement.md): 비워두면 docker-compose.prod.yml의 기본값(RFC1918 전체)이
# 적용되어 app 네트워크의 모든 컨테이너가 신뢰 프록시로 취급된다 — 실제 Caddy 서브넷으로
# 좁혀서 설정한다. 부득이 광역대를 그대로 써야 하면 validate-env.sh가 거부하지 않도록
# KRAFT_ALLOW_BROAD_TRUSTED_PROXY=true를 함께 설정해야 한다.
KRAFT_SECURITY_TRUSTED_PROXY_CIDR=${KRAFT_SECURITY_TRUSTED_PROXY_CIDR}
KRAFT_SECURITY_RATE_LIMIT_PER_MINUTE=120
KRAFT_SECURITY_RATE_LIMIT_MAX_KEYS=10000
KRAFT_COMMUNITY_WRITE_RATE_LIMIT_PER_MINUTE=20
# in-memory(기본, 단일 인스턴스)로 충분한 동안은 건드릴 필요 없음. backend를 여러
# 인스턴스로 스케일아웃할 때만 redis로 바꾸고, 별도로 준비한 Redis를 KRAFT_REDIS_HOST/PORT로
# 가리킨다 — 이 compose 스택은 Redis를 직접 제공하지 않는다.
KRAFT_RATE_LIMIT_BACKEND=in-memory
KRAFT_REDIS_HOST=localhost
KRAFT_REDIS_PORT=6379
# scripts/deploy/validate-env.sh가 KRAFT_ADMIN_ALLOWED_CIDR=0.0.0.0/0을 차단한다 —
# 의도적으로 전체 개방하려면(권장하지 않음) 아래를 명시적으로 true로 설정.
# KRAFT_ALLOW_WORLD_OPEN_ADMIN=true
# scripts/deploy/smoke-test.sh의 선택적 rate-limit 버스트 테스트 — 기본은 비활성화(false).
# KRAFT_SMOKE_RATE_LIMIT=true
# KRAFT_SMOKE_RATE_LIMIT_BURST=130
# admin_users 테이블이 비어있을 때만 1회성으로 계정을 생성함 (AdminBootstrap.java).
# 계정 생성 후에는 이 두 시크릿 값을 제거할 것.
KRAFT_ADMIN_BOOTSTRAP_USERNAME=${KRAFT_ADMIN_BOOTSTRAP_USERNAME}
KRAFT_ADMIN_BOOTSTRAP_PASSWORD=${KRAFT_ADMIN_BOOTSTRAP_PASSWORD}

# ── 커뮤니티 OAuth2 (Google/Naver 개발자 콘솔에서 발급) ───────────────────────────
# provider별 ID와 secret을 모두 채우면 해당 로그인이 활성화된다. 둘 다 비우면 비활성화되지만,
# 둘 중 하나만 채운 부분 설정은 validate-env.sh가 배포 전에 차단한다.
KRAFT_COMMUNITY_GOOGLE_CLIENT_ID=${KRAFT_COMMUNITY_GOOGLE_CLIENT_ID}
KRAFT_COMMUNITY_GOOGLE_CLIENT_SECRET=${KRAFT_COMMUNITY_GOOGLE_CLIENT_SECRET}
KRAFT_COMMUNITY_NAVER_CLIENT_ID=${KRAFT_COMMUNITY_NAVER_CLIENT_ID}
KRAFT_COMMUNITY_NAVER_CLIENT_SECRET=${KRAFT_COMMUNITY_NAVER_CLIENT_SECRET}

# ── Revalidate ────────────────────────────────────────────────────────────────
KRAFT_REVALIDATE_WEB_URL=http://web:3000

# ── Web (Next.js) ─────────────────────────────────────────────────────────────
KRAFT_BACKEND_INTERNAL_URL=http://backend:8080
KRAFT_PUBLIC_BASE_URL=${KRAFT_PUBLIC_BASE_URL}

# ── Caddy ─────────────────────────────────────────────────────────────────────
KRAFT_DOMAIN=${KRAFT_DOMAIN}
KRAFT_ADMIN_DOMAIN=${KRAFT_ADMIN_DOMAIN}

# ── Web Ops 호스트 제한 (web/src/proxy.ts) ──────────────────────────────────────
# fail-closed: 비워두면 /ops가 모든 호스트에서 차단된다(proxy.ts가 404를 반환) — "제한 없음"이 아니다.
# prod에서는 반드시 KRAFT_ADMIN_DOMAIN과 동일하게 설정한다.
KRAFT_OPS_ALLOWED_HOST=${KRAFT_OPS_ALLOWED_HOST}

# ── Caddy 관리자 도메인 IP 제한 (caddy/Caddyfile) ────────────────────────────────
# 비워두면 전체 허용. VPN/고정 IP가 준비되면 CIDR로 채울 것 (예: 203.0.113.4/32).
KRAFT_ADMIN_ALLOWED_CIDR=${KRAFT_ADMIN_ALLOWED_CIDR}

# ── Docker image refs ─────────────────────────────────────────────────────────
KRAFT_BACKEND_IMAGE_REF=${KRAFT_BACKEND_IMAGE_REF}
KRAFT_BACKEND_IMAGE_TAG=${KRAFT_BACKEND_IMAGE_TAG}
KRAFT_WEB_IMAGE_REF=${KRAFT_WEB_IMAGE_REF}
KRAFT_WEB_IMAGE_TAG=${KRAFT_WEB_IMAGE_TAG}

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
ALERTMANAGER_DISCORD_WEBHOOK_URL=${ALERTMANAGER_DISCORD_WEBHOOK_URL}
# 선택 사항 — Prometheus/Alertmanager 자체가 죽어 Discord로도 알림이 안 가는 상황을
# 감지하기 위한 외부 heartbeat(healthchecks.io 등) URL. 미설정이면 Watchdog 경보
# 전송만 조용히 실패하고 나머지 배포는 그대로 진행된다.
KRAFT_HEARTBEAT_URL=${KRAFT_HEARTBEAT_URL}
