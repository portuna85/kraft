# 전역 옵션 — 이게 없으면 :2020의 metrics 엔드포인트가 떠 있어도 caddy_http_requests_total·
# caddy_http_request_duration_seconds 같은 요청 단위 지표 자체가 전혀 수집되지 않는다
# (로컬에서 직접 확인함 — servers 아래 nested metrics는 최신 Caddy에서 deprecated고,
# 이 전역 옵션이 그 대체다). Phase 10 P10-5에서 발견: 지금까지 이 옵션이 빠져 있어
# :2020/metrics는 리버스 프록시 업스트림 헬스 상태·Go 런타임 지표만 노출하고 있었다.
{
	metrics
}

# Prometheus 전용 metrics 리스너. admin API(기본 127.0.0.1:2019, 인증 없이 전체 설정을
# 읽고 바꿀 수 있음)는 loopback에만 묶어두고, 이 리스너는 metrics만 서빙해 app/monitoring
# 네트워크의 다른 컨테이너에도 안전하게 노출한다. 호스트에는 포트를 publish하지 않는다.
:2020 {
	metrics
}

www.{$KRAFT_DOMAIN} {
	redir https://{$KRAFT_DOMAIN}{uri} permanent
}

{$KRAFT_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
	header Permissions-Policy "geolocation=(), microphone=(), camera=()"
	# 앱(web/backend)이 응답마다 자체 CSP를 설정하지만, Caddy가 직접 만드는 403(@blocked) 등에는
	# 앱 헤더가 안 붙는다 — 그런 응답도 프레이밍 공격에서 방어되도록 최소 헤더를 여기서도 건다.
	header X-Frame-Options "DENY"
	encode zstd gzip

	# I-12: 2026-08-15 21:19~21:25경 RSC prefetch(?_rsc=...)가 여러 라우트에서 동시에 503을
	# 낸 사건을 사후에 조사할 로그가 전혀 없었다(이 사이트 블록에 log 지시자 자체가 없었음 —
	# {$KRAFT_ADMIN_DOMAIN} 블록만 별도 인시던트 때문에 로그가 있었다). 재발 시 진단 가능하도록
	# 접근 로그를 추가한다. JSON으로 남겨 이후 쿼리 가능하게 한다.
	log {
		output stdout
		format json
	}

	# route { } 로 감싸서 Caddy의 자동 specificity 정렬을 비활성화하고
	# 아래 순서(첫 매치 우선)를 그대로 보장한다. 정렬에 맡기면 @blocked가
	# catch-all reverse_proxy 뒤로 밀려나 /admin* 차단이 무력화된다.
	route {
		# I-33: 이 403은 앱을 거치지 않고 Caddy가 직접 낸다 — 본문·title·lang이 없어
		# 빈 화면처럼 보였다. 차단 사유를 드러내지 않는 선에서 최소 본문만 붙인다.
		# respond의 기본 Content-Type은 text/plain이라, HTML을 그대로 렌더하려면
		# 명시적으로 text/html로 바꿔줘야 한다.
		@blocked path /actuator* /ops* /admin* /api/revalidate
		header @blocked Content-Type "text/html; charset=utf-8"
		respond @blocked `<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>403</title></head><body><h1>403 Forbidden</h1></body></html>` 403

		# 정적 자산 장기 캐시 (Next.js 콘텐츠 해시 포함)
		# KF-21(docs/improvement.md): Next 16이 실제 발행하는 OG 경로는 콘텐츠 해시
		# 접미사가 붙는다(예: /opengraph-image-1c1a04?6824bb158b9cd20d,
		# /analysis/opengraph-image-p0tcmv?...) — 정확 경로 매치로는 루트 OG조차
		# 안 걸려 7개 전부 아래 60s catch-all로 떨어졌었다. 경로 해시 + 쿼리 해시를
		# 둘 다 가져 접두 매치로도 immutable 캐싱이 안전하다.
		@immutable path /_next/static/* /icon/* /apple-icon /opengraph-image* /*/opengraph-image*
		handle @immutable {
			header Cache-Control "public, max-age=31536000, immutable"
			reverse_proxy web:3000 {
				header_up X-Real-IP {remote_host}
			}
		}

		# OG 이미지: 쿼리 파라미터(번호·회차·당첨금 등)에 데이터가 자기완결적으로 들어 있어
		# 사실상 불변이다. 소셜 스크레이퍼·재공유 트래픽의 이미지 재렌더 비용을 없애기 위해 장기 캐시.
		@og path /api/og/*
		handle @og {
			header Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
			reverse_proxy web:3000 {
				header_up X-Real-IP {remote_host}
			}
		}

		handle /api/v1/* {
			reverse_proxy backend:8080 {
				header_up X-Real-IP {remote_host}
				transport http {
					dial_timeout 3s
					response_header_timeout 5s
				}
			}
		}

		# 커뮤니티 OAuth2 로그인 플로우(CommunitySecurityConfig)는 Spring Security가 직접
		# 서빙한다 — Next.js에는 이 경로들이 없다. catch-all(web:3000)로 새면 전부 404다.
		@community_auth path /oauth2/* /login* /logout
		handle @community_auth {
			header Cache-Control "no-store"
			reverse_proxy backend:8080 {
				header_up X-Real-IP {remote_host}
				transport http {
					dial_timeout 3s
					response_header_timeout 5s
				}
			}
		}

		# 개인화·상태변경 페이지는 catch-all의 60s 공개 캐시에서 제외한다(§4.4) —
		# 글쓰기·수정 화면은 로그인 사용자 전용이며 폼 상태가 캐시되면 안 된다.
		# M-08: 게시글 상세(/community/posts/*, 수정 화면 포함)도 여기 포함한다 — 백엔드
		# GET이 조회수를 올리는 부수효과가 있어 web/의 page.tsx가 force-dynamic으로
		# no-store를 전제하는데, 목록(/community)만 제외하고 상세는 빠져 있어 catch-all의
		# public, max-age=60이 그대로 걸리고 있었다. 목록 자체(/community, 세그먼트 없음)는
		# 이 패턴에 안 걸리므로 계속 60s 캐시를 받는다.
		@community_no_cache path /community/write /community/posts/*
		handle @community_no_cache {
			header Cache-Control "no-store"
			reverse_proxy web:3000 {
				header_up X-Real-IP {remote_host}
			}
		}

		# H-2: 이 두 경로는 인증되지 않은 브라우저가 직접 POST하는 텔레메트리 수신처라
		# /api/v1/*(백엔드 프록시, PublicRateLimitFilter 적용 대상)와 달리 어떤 속도 제한도
		# 거치지 않았다. 본문 상한은 여기서 먼저 걸고(오버사이즈 요청이 web 컨테이너까지
		# 가지 않게), 속도 제한·샘플링은 애플리케이션 라우트(vitals/csp-report route.ts)에서
		# 처리한다 — 이 베이스 이미지에는 rate-limit 모듈이 없다.
		@telemetry path /api/vitals /api/csp-report
		handle @telemetry {
			header Cache-Control "no-store"
			request_body {
				max_size 20KB
			}
			reverse_proxy web:3000 {
				header_up X-Real-IP {remote_host}
			}
		}

		# H-05: /api/client-error도 @telemetry와 같은 인증되지 않은 텔레메트리 수신처지만
		# web/src/app/api/client-error/route.ts의 MAX_BODY_BYTES=4096과 정확히 맞춘 별도
		# matcher를 둔다 — 20KB로 묶으면 chunked/미지정 Content-Length 요청이 앱 프로세스
		# 메모리까지 버퍼링된 뒤에야 잘리는 5배 차이 구간이 생긴다.
		@client_error path /api/client-error
		handle @client_error {
			header Cache-Control "no-store"
			request_body {
				max_size 4KB
			}
			reverse_proxy web:3000 {
				header_up X-Real-IP {remote_host}
			}
		}

		handle {
			# 모든 페이지 경로: 브라우저 SWR 60s+300s.
			# nonce 기반 CSP 때문에 HTML+CSP 헤더가 함께 캐시돼야 안전하므로
			# CDN용 s-maxage는 추가하지 않음 (CDN 도입 시 nonce 제거 먼저 필요).
			# I-09: header 지시자를 reverse_proxy보다 앞에 두면 업스트림(Next.js)이 이미
			# 낸 Cache-Control(레이아웃의 headers() 호출로 전 라우트가 동적 렌더라 항상
			# private, no-store 계열)에 "교체"가 아니라 "추가"가 된다. RFC 9110상 동일 필드명이
			# 두 개면 쉼표로 이어붙인 것과 동치라 모든 캐시가 더 제한적인 지시자를 채택한다.
			# reverse_proxy의 header_down은 업스트림 헤더를 실제로 교체하므로 여기로 옮긴다.
			reverse_proxy web:3000 {
				header_up X-Real-IP {remote_host}
				header_down Cache-Control "public, max-age=60, stale-while-revalidate=300"
				@error status 4xx 5xx
				handle_response @error {
					# copy_response가 없으면 원본 상태코드/본문이 버려지고 200 빈 응답으로 대체된다 —
					# 이 블록의 목적은 헤더 교체뿐이므로 반드시 원본 응답을 그대로 복사한 뒤 헤더만 덮어쓴다.
					copy_response
					# 4xx/5xx 오류 응답은 위의 기본 Cache-Control을 상속해 캐시되면 안 되므로 명시적으로 덮어쓴다.
					header Cache-Control "no-store"
				}
			}
		}
	}
}

{$KRAFT_ADMIN_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
	header Permissions-Policy "geolocation=(), microphone=(), camera=()"
	header X-Frame-Options "DENY"
	encode zstd gzip

	# 진단용 액세스 로그. remote_ip allowlist가 실제로 어떤 IP를 보는지 확인하기 위함
	# (2026-06-23 인시던트: 자가 헬스체크/스모크 테스트가 막혀 원인 파악이 필요했음).
	log {
		output stdout
		format console
	}

	route {
		# 관리자 도메인 IP 제한. 기본값은 docker-compose.prod.yml의 KRAFT_ADMIN_ALLOWED_CIDR
		# 환경변수 단계에서 보장한다(여기 :default는 compose 없이 caddy를 직접 띄울 때를
		# 위한 2차 방어선일 뿐, 정상 운영에서는 항상 compose가 채운 값이 들어온다).
		@not_allowed not remote_ip {$KRAFT_ADMIN_ALLOWED_CIDR:0.0.0.0/0 ::/0}
		respond @not_allowed 403

		@blocked path /actuator*
		respond @blocked 403

		# 정적 자산 장기 캐시 — KF-21(docs/improvement.md): public 도메인 블록과 같은
		# 이유로 OG 경로를 접두 매치로 바꾼다(콘텐츠 해시 접미사 때문에 정확 매치가
		# 안 걸렸다).
		@immutable path /_next/static/* /icon/* /apple-icon /opengraph-image* /*/opengraph-image*
		handle @immutable {
			header Cache-Control "public, max-age=31536000, immutable"
			reverse_proxy web:3000 {
				header_up X-Real-IP {remote_host}
			}
		}

		handle /api/v1/* {
			reverse_proxy backend:8080 {
				header_up X-Real-IP {remote_host}
				transport http {
					dial_timeout 3s
					response_header_timeout 5s
				}
			}
		}

		# TD-001: 수동 수집(POST /ops/collect/latest, /ops/collect/{round})은 백엔드가
		# 외부 API를 최대 2회 재시도(3초 connect + 5초 read, 500ms 대기)하며 최악 약
		# 16.5초가 걸릴 수 있다. 나머지 /ops-api/*(summary/logs/rounds)와 같은 5초
		# 상한을 쓰면 백엔드가 아직 재시도 중인데도 이 경로에서 먼저 타임아웃돼 운영자에게
		# 실패로 보인다 — collect 경로만 분리해 여유를 둔 20초를 적용한다. 더 구체적인
		# 매처를 아래 일반 /ops-api/* 핸들보다 먼저 둬 우선 매칭되게 한다.
		handle_path /ops-api/collect/* {
			rewrite * /ops/collect{uri}
			reverse_proxy backend:8080 {
				header_up X-Real-IP {remote_host}
				transport http {
					dial_timeout 3s
					response_header_timeout 20s
				}
			}
		}

		handle_path /ops-api/* {
			rewrite * /ops{uri}
			reverse_proxy backend:8080 {
				header_up X-Real-IP {remote_host}
				transport http {
					dial_timeout 3s
					response_header_timeout 5s
				}
			}
		}

		# 관리자 화면(Thymeleaf SSR) — 최초 인프라 설정 때부터 이 라우트가
		# 빠져 있어 /admin*이 전부 web(Next.js)의 catch-all로 빠져 404였다.
		handle /admin* {
			reverse_proxy backend:8080 {
				header_up X-Real-IP {remote_host}
				transport http {
					dial_timeout 3s
					response_header_timeout 5s
				}
			}
		}

		handle /grafana/* {
			reverse_proxy grafana:3000 {
				header_up X-Real-IP {remote_host}
			}
		}

		handle {
			reverse_proxy web:3000 {
				header_up X-Real-IP {remote_host}
			}
		}
	}
}
