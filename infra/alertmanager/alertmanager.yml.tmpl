# Template file — rendered by scripts/deploy/render-alertmanager.sh
# Variables: ALERTMANAGER_DISCORD_WEBHOOK_URL, KRAFT_HEARTBEAT_URL
global:
  resolve_timeout: 5m

route:
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: discord-default
  routes:
    # Watchdog은 상시 발화하는 생존 확인용 경보라 Discord가 아니라 외부 heartbeat
    # 서비스로만 보낸다 — Alertmanager/Prometheus 자체가 죽어 Discord로도 아무것도
    # 전달되지 않는 상황(AlertmanagerDown/PrometheusDown 참고)에서 마지막으로 남는 신호다.
    - matchers:
        - alertname = "Watchdog"
      receiver: heartbeat
      group_wait: 0s
      repeat_interval: 5m

receivers:
  - name: discord-default
    discord_configs:
      # Discord webhook is bound to a specific channel, so no channel field is
      # needed (unlike Slack). Native support since Alertmanager v0.25.
      #
      # 알림 룰(kraft_alerts.yml)의 annotations.title/summary/description/runbook은
      # 이미 한국어로 작성돼 있다 — 여기서는 그 값을 한국 운영자가 바로 판단할 수 있는
      # 구조화된 형태로 배치하고, FIRING/RESOLVED 상태와 시각만 이 템플릿에서 한국어로
      # 렌더링한다. 라벨(심각도 등)과 GeneratorURL(Prometheus 쿼리 링크)은 그대로 보존한다.
      - webhook_url: "${ALERTMANAGER_DISCORD_WEBHOOK_URL}"
        send_resolved: true
        title: |
          {{ if eq .Status "firing" }}🚨 장애 발생{{ else }}✅ 장애 복구{{ end }} · {{ .CommonAnnotations.title }}
        message: |
          {{ range .Alerts }}
          {{ if eq .Status "firing" }}🚨 **장애 발생**{{ else }}✅ **장애 복구**{{ end }}

          **서비스**
          KRAFT Lotto

          **알림**
          {{ .Annotations.title }} (`{{ .Labels.alertname }}`)

          **내용**
          {{ .Annotations.summary }}
          {{ .Annotations.description }}
          {{ if eq .Status "firing" }}
          **확인 사항**
          {{ .Annotations.runbook }}
          {{ end }}
          **라벨**
          {{ range .Labels.SortedPairs }}`{{ .Name }}={{ .Value }}` {{ end }}

          **{{ if eq .Status "firing" }}발생 시간{{ else }}복구 시간{{ end }}**
          {{ if eq .Status "firing" }}{{ .StartsAt.Format "2006-01-02 15:04:05 MST" }}{{ else }}{{ .EndsAt.Format "2006-01-02 15:04:05 MST" }}{{ end }}

          **Prometheus 쿼리**
          {{ .GeneratorURL }}
          --------------------------------
          {{ end }}
  - name: heartbeat
    webhook_configs:
      # 특정 제품에 종속시키지 않는다 — 주기적 GET/POST를 받아들이는 heartbeat
      # 서비스(healthchecks.io 등)라면 무엇이든 동작한다. 미설정 시
      # render-alertmanager.sh가 더미 URL로 채우므로 여기는 항상 유효한 URL을 받는다.
      - url: "${KRAFT_HEARTBEAT_URL}"
        send_resolved: false

inhibit_rules:
  - source_matchers:
      - severity = critical
    target_matchers:
      - severity = warning
    equal: [alertname]
