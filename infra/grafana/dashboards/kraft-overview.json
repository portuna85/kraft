{
  "id": null,
  "uid": "kraft-overview",
  "title": "KRAFT 운영 개요",
  "tags": ["kraft"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Backend up",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"kraft-backend\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "5xx 오류율",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\",job=\"kraft-backend\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"kraft-backend\"}[5m]))",
          "refId": "A",
          "legendFormat": "5xx rate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 3,
      "title": "P95 응답 시간",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"kraft-backend\"}[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "title": "JVM heap 사용률",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\",job=\"kraft-backend\"} / jvm_memory_max_bytes{area=\"heap\",job=\"kraft-backend\"}",
          "refId": "A",
          "legendFormat": "heap usage"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 5,
      "title": "데이터 신선도 (지연 일수)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "kraft_lotto_data_stale_days{job=\"kraft-backend\"}",
          "refId": "A",
          "legendFormat": "stale days"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "d" } }
    },
    {
      "id": 6,
      "title": "추천 실패율",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(kraft_lotto_recommend_failures_total{job=\"kraft-backend\"}[10m])) / sum(rate(kraft_lotto_recommend_requests_total{job=\"kraft-backend\"}[10m]))",
          "refId": "A",
          "legendFormat": "실패율"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 7,
      "title": "마지막 백업 이후 경과 시간",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "time() - kraft_backup_last_success_timestamp_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 8,
      "title": "커뮤니티 OAuth 로그인 (provider/결과별)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(kraft_community_oauth_login_total{job=\"kraft-backend\"}[5m])) by (provider, outcome)",
          "refId": "A",
          "legendFormat": "{{provider}}/{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 9,
      "title": "커뮤니티 쓰기 거부 (CSRF·버전 충돌)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(kraft_community_csrf_rejected_total{job=\"kraft-backend\"}[5m]))",
          "refId": "A",
          "legendFormat": "CSRF 거부"
        },
        {
          "expr": "sum(rate(kraft_community_post_version_conflict_total{job=\"kraft-backend\"}[5m]))",
          "refId": "B",
          "legendFormat": "버전 충돌(409)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 10,
      "title": "엣지 5xx 오류율 (Caddy, 사이트 전체)",
      "type": "timeseries",
      "description": "Phase 10 컷오버 관찰용. web:3000·backend:8080이 Caddy 안에서 같은 서버 블록을 공유해 앱별로 못 나눈다 — 사이트 전체 5xx율이다. 컷오버 직후 이 값이 튀면 web/ 배포를 의심한다(그 시점엔 backend 이미지가 그대로이므로).",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 9, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "sum(rate(caddy_http_requests_total{job=\"caddy\",code=~\"5..\"}[5m])) / sum(rate(caddy_http_requests_total{job=\"caddy\"}[5m]))",
          "refId": "A",
          "legendFormat": "5xx rate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 11,
      "title": "엣지 P95 응답 시간 (Caddy, 사이트 전체)",
      "type": "timeseries",
      "description": "Phase 10 컷오버 관찰용. 5xx 오류율 패널과 같은 이유로 앱별로 못 나눈 사이트 전체 값이다.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 9, "x": 9, "y": 28 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(caddy_http_request_duration_seconds_bucket{job=\"caddy\"}[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 12,
      "title": "외부 회차 수집 시간 vs 20초 예산",
      "type": "timeseries",
      "description": "재시도를 포함한 수집 작업 전체 시간. ops 클라이언트·Caddy 예산(20초)에 가까워지면 외부 소스 지연과 재시도 횟수를 함께 확인한다.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "targets": [
        {
          "expr": "sum(rate(kraft_lotto_external_collect_duration_seconds_sum{job=\"kraft-backend\"}[5m])) by (operation) / sum(rate(kraft_lotto_external_collect_duration_seconds_count{job=\"kraft-backend\"}[5m])) by (operation)",
          "refId": "A",
          "legendFormat": "{{operation}} 평균"
        },
        {
          "expr": "max_over_time(kraft_lotto_external_collect_duration_seconds_max{job=\"kraft-backend\"}[5m])",
          "refId": "B",
          "legendFormat": "5분 최대"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "title": "비동기 실행기와 리스너 실패",
      "type": "timeseries",
      "description": "eventTaskExecutor 포화와 호출자에게 반환되지 않는 @Async void 리스너 실패를 함께 본다.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "targets": [
        {
          "expr": "executor_active_threads{name=\"eventTaskExecutor\",job=\"kraft-backend\"}",
          "refId": "A",
          "legendFormat": "active"
        },
        {
          "expr": "executor_queued_tasks{name=\"eventTaskExecutor\",job=\"kraft-backend\"}",
          "refId": "B",
          "legendFormat": "queued"
        },
        {
          "expr": "sum(increase(kraft_async_listener_failures_total{job=\"kraft-backend\"}[15m])) by (listener)",
          "refId": "C",
          "legendFormat": "failure {{listener}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "애플리케이션 캐시 적중·축출",
      "type": "timeseries",
      "description": "크기 조정 전 캐시별 적중률과 최근 한 시간 축출 수를 확인한다.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{job=\"kraft-backend\",result=\"hit\"}[10m])) by (cache) / sum(rate(cache_gets_total{job=\"kraft-backend\"}[10m])) by (cache)",
          "refId": "A",
          "legendFormat": "hit ratio {{cache}}"
        },
        {
          "expr": "sum(increase(cache_evictions_total{job=\"kraft-backend\"}[1h])) by (cache)",
          "refId": "B",
          "legendFormat": "evictions {{cache}}"
        }
      ]
    },
    {
      "id": 15,
      "title": "정리·통계 재구축 작업 시간",
      "type": "timeseries",
      "description": "회원 탈퇴 추천 데이터 벌크 삭제와 통계 요약 재구축의 평균 실행 시간이다.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "targets": [
        {
          "expr": "sum(rate(kraft_recommendation_account_deletion_duration_seconds_sum{job=\"kraft-backend\"}[10m])) / sum(rate(kraft_recommendation_account_deletion_duration_seconds_count{job=\"kraft-backend\"}[10m]))",
          "refId": "A",
          "legendFormat": "account deletion"
        },
        {
          "expr": "sum(rate(statistics_summary_rebuild_duration_seconds_sum{job=\"kraft-backend\"}[10m])) / sum(rate(statistics_summary_rebuild_duration_seconds_count{job=\"kraft-backend\"}[10m]))",
          "refId": "B",
          "legendFormat": "statistics rebuild"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
