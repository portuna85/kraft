{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": true,
    "strict": false,
    "strictNullChecks": true,
    "allowJs": true,
    "types": [
      "bootstrap"
    ],
    "paths": {
      "@core/*": [
        "./src/main/resources/static/js/app/core/*"
      ],
      "@ui/*": [
        "./src/main/resources/static/js/app/ui/*"
      ]
    }
  },
  "include": [
    "types/**/*",
    "src/main/resources/static/js/**/*",
    "src/vue/**/*.js"
  ],
  "exclude": [
    "src/main/resources/static/js/vue-dist/**",
    "src/main/resources/static/js/vendor/**",
    "**/*.test.js",
    "src/vue/vite.config.js"
  ]
}
