<?xml version="1.0" encoding="UTF-8"?>
<!--
    로그 파일 분리 정책.

    - kraft.log        : 전체 애플리케이션 로그(콘솔과 동일한 내용, INFO 이상). Hibernate SQL은
                          너무 시끄러워서 여기에는 안 남기고 kraft-sql.log로 분리한다(아래 참고).
    - kraft-error.log  : ERROR 레벨만 모아서 빠르게 장애를 훑어볼 수 있게 별도로 남긴다.
                          어떤 로거에서 나온 것이든(Hibernate 포함) 전부 여기에 모인다.
    - kraft-sql.log    : org.hibernate.SQL / org.hibernate.orm.jdbc.bind. additivity="false"라
                          kraft.log에는 안 섞이고 콘솔·이 파일에만 남는다(개발 편의용, 레벨은
                          logging.level.org.hibernate.SQL로 각 application-*.yml에서 켠다).
    - kraft-security.log : org.springframework.security. kraft.log에도 그대로 섞여 남고(둘 다
                          보고 싶을 때가 있어서), 이 파일에는 그 로그만 따로도 모인다.
    - kraft-email.log  : com.kraft.service.user(이메일 인증 발급·재발송, 실제 SMTP 발송)만 따로
                          모은다 — 이메일 발송 문제를 조사할 때 다른 로그에 섞이지 않게 하기 위해서다.

    - kraft-metrics.log : com.kraft.observability(주기 상태 점검) 전용. additivity="false"라
                          kraft.log에는 안 섞인다 — 5분마다 남는 정상 보고가 다른 로그를 밀어내지
                          않게 하기 위해서다. 다만 ERROR(임계 초과)는 kraft-error.log에도 남는다.

    파일은 logs/ 아래에 남고(.gitignore에 등록됨), 매일 또는 20MB를 넘길 때 회전해
    logs/archive/*.log.gz로 압축 보관한다.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="logs"/>
    <property name="LOG_ARCHIVE" value="${LOG_PATH}/archive"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/kraft.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/kraft.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/kraft-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/kraft-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="SQL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/kraft-sql.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/kraft-sql.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="SECURITY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/kraft-security.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/kraft-security.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="EMAIL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/kraft-email.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/kraft-email.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="METRICS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/kraft-metrics.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/kraft-metrics.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- additivity="false": kraft.log(루트)에는 안 남기고 콘솔 + 전용 파일에만 남긴다.
         레벨은 각 application-*.yml의 logging.level.org.hibernate.SQL이 결정한다. -->
    <logger name="org.hibernate.SQL" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SQL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <logger name="org.hibernate.orm.jdbc.bind" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SQL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- additivity 기본값(true) 유지: kraft.log에도 그대로 남고, 전용 파일에도 따로 모인다. -->
    <logger name="org.springframework.security" additivity="true">
        <appender-ref ref="SECURITY_FILE"/>
    </logger>

    <logger name="com.kraft.service.user" additivity="true">
        <appender-ref ref="EMAIL_FILE"/>
    </logger>

    <!-- additivity="false": 5분마다 남는 정상 보고로 kraft.log를 채우지 않는다.
         임계를 넘긴 ERROR만 ERROR_FILE에 함께 남아 장애를 훑을 때 보인다. -->
    <logger name="com.kraft.observability" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="METRICS_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
