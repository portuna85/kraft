<?xml version="1.0" encoding="UTF-8"?>
<!--
    로그 파일 분리 정책. 파일은 logs/ 아래(.gitignore)에 남고 매일 또는 20MB를 넘길 때 회전해 logs/archive/*.log.gz로 압축 보관한다. 파일마다 totalSizeCap이 있어
    합계가 약 700MB를 넘지 않는다(주 로그 300MB, error·sql·security 100MB, email·metrics 50MB).

    - kraft.log          : 전체 애플리케이션 로그(INFO 이상, 콘솔과 같은 내용). Hibernate SQL은 너무 시끄러워 kraft-sql.log로 분리한다.
    - kraft-error.log    : ERROR만 모아 장애를 빠르게 훑는다(어떤 로거에서 나온 것이든).
    - kraft-sql.log      : org.hibernate.SQL / org.hibernate.orm.jdbc.bind. additivity="false"라 kraft.log에는 안 섞인다(레벨은 각 application-*.yml의 logging.level.org.hibernate.SQL).
    - kraft-security.log : org.springframework.security. kraft.log에도 그대로 남고 이 파일에도 따로 모인다.
    - kraft-email.log    : com.kraft.user.service·com.kraft.user.mail(인증 발급·재발송·SMTP) — 이메일 발송 문제를 조사할 때 다른 로그에 섞이지 않게.
    - kraft-metrics.log  : com.kraft.observability(주기 상태 점검). additivity="false"라 5분마다 남는 정상 보고가 kraft.log를 밀어내지 않고, ERROR(임계 초과)는 kraft-error.log에도 남는다.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="logs"/>
    <property name="LOG_ARCHIVE" value="${LOG_PATH}/archive"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/kraft.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/kraft.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/kraft-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/kraft-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="SQL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/kraft-sql.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/kraft-sql.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="SECURITY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/kraft-security.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/kraft-security.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="EMAIL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/kraft-email.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/kraft-email.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="METRICS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/kraft-metrics.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/kraft-metrics.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- additivity="false": kraft.log(루트)에는 안 남기고 콘솔 + 전용 파일에만 남긴다. 레벨은 각 application-*.yml의 logging.level.org.hibernate.SQL이 정한다. -->
    <logger name="org.hibernate.SQL" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SQL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <logger name="org.hibernate.orm.jdbc.bind" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SQL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- Hibernate의 연결 정보 INFO에는 JDBC URL에 덧붙은 DB 비밀번호가 포함될 수 있다. -->
    <logger name="org.hibernate.orm.connections.pooling" level="WARN"/>

    <!-- additivity 기본값(true) 유지: kraft.log에도 그대로 남고, 전용 파일에도 따로 모인다. -->
    <logger name="org.springframework.security" additivity="true">
        <appender-ref ref="SECURITY_FILE"/>
    </logger>

    <logger name="com.kraft.user.service" additivity="true">
        <appender-ref ref="EMAIL_FILE"/>
    </logger>

    <logger name="com.kraft.user.mail" additivity="true">
        <appender-ref ref="EMAIL_FILE"/>
    </logger>

    <!-- additivity="false": 5분마다 남는 정상 보고로 kraft.log를 채우지 않는다. ERROR만 ERROR_FILE에 함께 남는다. -->
    <logger name="com.kraft.observability" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="METRICS_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- prod는 systemd로 뜨고 stdout을 journald가 수집하므로 CONSOLE이 FILE과 같은 내용을 중복으로 남긴다 — prod에서는 CONSOLE을 뺀다(파일 쪽이 회전·보관 정책을 갖춘
         원본). local·test는 콘솔에서 바로 보는 편이 유용해 그대로 둔다. -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>
</configuration>
