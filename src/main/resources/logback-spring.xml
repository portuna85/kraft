<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="logs"/>
    <springProperty scope="context" name="ROOT_LEVEL" source="logging.level.root" defaultValue="INFO"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS, Asia/Seoul} %-5level [%thread] [%X{requestId:-no-request}] %logger{36} - %msg%n%ex"/>
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS, Asia/Seoul} %-5level [%thread] [%X{requestId:-no-request}] %logger{60} - %msg%n%ex"/>
    <property name="MAX_FILE_SIZE" value="10MB"/>
    <property name="MAX_HISTORY" value="30"/>
    <property name="TOTAL_SIZE_CAP" value="1GB"/>
    <property name="ERROR_TOTAL_SIZE_CAP" value="200MB"/>
    <property name="LOCAL_MAX_HISTORY" value="7"/>
    <property name="LOCAL_TOTAL_SIZE_CAP" value="100MB"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 로컬: 단일 활성 파일을 유지하되 개발 중 무제한으로 커지지 않도록 7일 동안 롤링한다. -->
    <springProfile name="local">
        <appender name="LOCAL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/kraft-local.log</file>
            <append>true</append>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/archive/kraft-local.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                <maxHistory>${LOCAL_MAX_HISTORY}</maxHistory>
                <totalSizeCap>${LOCAL_TOTAL_SIZE_CAP}</totalSizeCap>
            </rollingPolicy>
        </appender>
    </springProfile>

    <!-- 테스트는 예상 예외를 대량으로 발생시키므로 파일을 만들지 않고 콘솔로만 확인한다. -->
    <springProfile name="!local &amp; !test &amp; !oauth-registration-test">
        <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/kraft.log</file>
            <append>true</append>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/archive/kraft.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                <maxHistory>${MAX_HISTORY}</maxHistory>
                <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            </rollingPolicy>
        </appender>

        <!--
            BE-OPS-02(docs/improvement.md): 가상 스레드 + 요청당 로그가 겹치면 요청 캐리어
            스레드가 동기 파일 I/O 중 로깅 락에 pinning될 수 있다. APP_FILE만 비동기로
            감싼다 — discardingThreshold=0은 큐가 80% 차도 INFO/DEBUG를 버리지 않는다는 뜻
            (기본값은 버린다). ERROR_FILE은 감싸지 않는다 — 크래시 직전 로그가 큐에 남은 채
            유실되는 것을 막기 위해서다(사고 조사에 가장 필요한 로그다).
        -->
        <appender name="ASYNC_APP_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="APP_FILE"/>
        </appender>

        <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/kraft-error.log</file>
            <append>true</append>
            <filter class="ch.qos.logback.classic.filter.LevelFilter">
                <level>ERROR</level>
                <onMatch>ACCEPT</onMatch>
                <onMismatch>DENY</onMismatch>
            </filter>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/archive/kraft-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                <maxHistory>${MAX_HISTORY}</maxHistory>
                <totalSizeCap>${ERROR_TOTAL_SIZE_CAP}</totalSizeCap>
            </rollingPolicy>
        </appender>
    </springProfile>

    <springProfile name="local">
        <root level="${ROOT_LEVEL}">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOCAL_FILE"/>
        </root>
    </springProfile>
    <springProfile name="test | oauth-registration-test">
        <root level="${ROOT_LEVEL}">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
    <springProfile name="!local &amp; !test &amp; !oauth-registration-test">
        <root level="${ROOT_LEVEL}">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_APP_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>
</configuration>
