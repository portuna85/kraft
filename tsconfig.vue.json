{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bootstrap"
    ],
    "paths": {
      "@core/*": [
        "./src/main/resources/static/js/app/core/*"
      ],
      "@ui/*": [
        "./src/main/resources/static/js/app/ui/*"
      ]
    },
    "strict": false,
    "strictNullChecks": true
  },
  "include": [
    "types/**/*",
    "src/vue/**/*.vue",
    "src/vue/**/*.js"
  ],
  "exclude": [
    "src/vue/**/*.test.js",
    "src/vue/vite.config.js"
  ]
}
