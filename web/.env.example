# Next.js 프로세스가 실제로 읽는 변수 목록이다. 서버 전용 값과 브라우저에 인라인되는
# NEXT_PUBLIC_* 값을 분리해, 공개 설정에 시크릿을 넣지 않도록 한다.

# ── 서버 런타임 전용 ──────────────────────────────────────────────────────────

# 서버 사이드 API 호출용 백엔드 내부 URL (Docker 네트워크 기준)
KRAFT_BACKEND_INTERNAL_URL=http://backend:8080

# canonical URL·OG·sitemap·robots에 쓰는 공개 기준 URL
KRAFT_PUBLIC_BASE_URL=https://your-domain.com

# /ops 호스트 게이트. 미설정은 "제한 없음"이 아니라 "차단"이다(fail-closed).
KRAFT_OPS_ALLOWED_HOST=

# 백엔드 RevalidateWebhookListener가 /api/revalidate를 부를 때 보내는 헤더 값과
# 일치해야 한다(백엔드의 KRAFT_REVALIDATE_SECRET와 같은 값).
KRAFT_REVALIDATE_SECRET=

# ── 브라우저 빌드 시점 공개 값(시크릿 금지) ───────────────────────────────────
# canonical URL·OG·sitemap·robots에도 쓰여 Docker 빌드 시 함께 주입된다.
NEXT_PUBLIC_AD_NETWORK=adfit
NEXT_PUBLIC_KAKAO_ADFIT_UNIT_FREQUENCY=
NEXT_PUBLIC_KAKAO_ADFIT_UNIT_FREQUENCY_DESKTOP=
NEXT_PUBLIC_KAKAO_ADFIT_UNIT_STICKY=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_UNIT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_UNIT_FREQUENCY=
NEXT_PUBLIC_ADSENSE_UNIT_FREQUENCY_MOBILE=
# 로컬에서 CLS 예약 공간을 확인할 때만 true. 운영 기본값은 비활성이다.
NEXT_PUBLIC_ADSENSE_RESERVE_PLACEHOLDER=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
