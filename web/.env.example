# 새 프론트엔드(Phase 0 스캐폴드)가 실제로 읽는 변수만 둔다 — 화면이 붙는 단계마다
# 필요한 변수를 추가한다. 배포 중인 앱의 전체 목록은 web-legacy/.env.example 참고.

# 서버 사이드 API 호출용 백엔드 내부 URL (Docker 네트워크 기준)
KRAFT_BACKEND_INTERNAL_URL=http://backend:8080

# canonical URL·OG·sitemap·robots에 쓰는 공개 기준 URL
KRAFT_PUBLIC_BASE_URL=https://your-domain.com

# /ops 호스트 게이트. 미설정은 "제한 없음"이 아니라 "차단"이다(fail-closed).
KRAFT_OPS_ALLOWED_HOST=

# 백엔드 RevalidateWebhookListener가 /api/revalidate를 부를 때 보내는 헤더 값과
# 일치해야 한다(백엔드의 KRAFT_REVALIDATE_SECRET와 같은 값).
KRAFT_REVALIDATE_SECRET=
