{
  "name": "kraft-lotto-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "local": "next dev",
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint src tests e2e scripts *.config.ts *.config.mts *.config.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node scripts/start-standalone.mjs",
    "e2e:fixture": "node e2e/fixtures/backend.mjs",
    "e2e:serve": "node scripts/start-standalone.mjs",
    "test": "vitest run",
    "test:e2e:proxy": "playwright test --config=playwright.proxy.config.ts",
    "test:e2e:default": "playwright test --config=playwright.default.config.ts",
    "test:e2e:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "test:e2e:visual:docker": "docker run --rm --ipc=host -v \"$(pwd)/..:/repo\" -w /repo/web mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e bash -c \"npm ci --prefer-offline --no-audit --no-fund && NEXT_DIST_DIR=.next-visual NEXT_ENABLE_STANDALONE_REWRITES=true KRAFT_BACKEND_INTERNAL_URL=http://127.0.0.1:4113 KRAFT_PUBLIC_BASE_URL=http://127.0.0.1:3113 npm run build && npm run test:e2e:visual\"",
    "test:e2e:cross-browser": "playwright test --config=playwright.cross-browser.config.ts",
    "test:e2e:cross-browser:default": "playwright test --config=playwright.cross-browser-default.config.ts",
    "test:e2e:responsive": "playwright test --config=playwright.responsive.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "verify:api-types": "node scripts/generate-api-types.mjs --verify",
    "budget:bundle": "node scripts/bundle-budget.mjs",
    "budget:lighthouse": "node scripts/lighthouse-budget.mjs",
    "fetch:fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "valibot": "^1.4.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.2",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "subset-font": "^2.5.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Safari versions",
    "last 2 Firefox versions",
    "last 2 iOS versions"
  ],
  "allowScripts": {
    "msw@2.15.0": true,
    "unrs-resolver@1.12.2": true
  }
}
